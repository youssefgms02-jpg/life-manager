{
  "name": "life-manager",
  "version": "1.0.0",
  "description": "Life Manager - personal planner",
  "author": "Yousef",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yousef.lifemanager",
    "productName": "Life Manager",
    "files": ["electron/**", "www/**", "assets/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "icon": "assets/icon.png" }
  }
}
